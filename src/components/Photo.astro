---
// A brand photograph. Serves AVIF and WebP at the widths it is actually shown at (never above the file's own width),
// crops with object-position, and opts into the scroll motion in src/scripts/motion.ts:
//   reveal   the photo unveils with a clip-path wipe as it scrolls into view
//   parallax the image drifts inside its frame while the page scrolls (motion.ts draws it slightly larger to leave room)
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { plain } from '../features';

interface Props {
  src: ImageMetadata;
  alt: string;
  position?: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  priority?: boolean;
  reveal?: boolean;
  parallax?: number;
  class?: string;
}

const { src, alt, position = '50% 50%', sizes, widths = [360, 540, 720, 960, 1280], eager = false, priority = false, reveal = false, parallax, class: cls } = Astro.props;
const { width } = plain(src);
const usable = widths.filter((w) => w <= width).concat(width).filter((w, i, all) => all.indexOf(w) === i);
// Two renditions per width and nothing else: the <Picture> component also copied every original into the build.
const avif = await getImage({ src, widths: usable, format: 'avif' });
const webp = await getImage({ src, widths: usable, format: 'webp' });
---

<figure class:list={['photo', cls]} data-photo-reveal={reveal ? '' : undefined} data-parallax={parallax ?? undefined}>
  <picture>
    <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
    <img
      src={webp.src}
      srcset={webp.srcSet.attribute}
      sizes={sizes}
      width={webp.attributes.width}
      height={webp.attributes.height}
      alt={alt}
      loading={eager || priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding="async"
      style={`object-position: ${position}`}
    />
  </picture>
</figure>

<style>
  .photo { position: relative; margin: 0; overflow: hidden; background: var(--cream-deep); }
  .photo :global(picture) { display: contents; }
  .photo :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
