---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import logotypeOrange from '../assets/brand/logotype-orange.png';
import { suites, businessTypes, icons } from '../features';
import FeatureMenu from '../components/FeatureMenu.astro';
import { appUrl, wa, waUrl, waSalesUrl, waDisplay, waNumber } from '../site';

interface Props {
  title: string;
  description: string;
  /** Opening WhatsApp message for this page's sticky mobile button. */
  wa?: string;
}

const { title, description, wa: waMessage } = Astro.props;
const waHref = waMessage ? wa(waMessage) : waUrl;
const chevron = '<svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg>';
const cross = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>';
const year = new Date().getFullYear();

// build.format 'file' names pages `harga.html` and `index.html`; Cloudflare Pages serves them at `/harga` and `/`.
const path = Astro.url.pathname.replace(/(?:\/index)?\.html$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Qash',
  description: 'Sistem operasional F&B lengkap untuk kedai, kafe, dan restoran di Indonesia.',
  url: new URL('/', Astro.site).href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'sales', telephone: `+${waNumber}`, availableLanguage: ['id', 'en'] }],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Qash" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ff8343" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-jost" preload />
    <Font cssVariable="--font-hanken" preload />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <ClientRouter />
    <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "b1689060e9f546bda05c1c4aa8079bdb"}'></script>

  </head>
  <body>
    <a href="#main" class="skip">Langsung ke konten</a>

    <header class="site-header" transition:persist="site-header">
      <div class="container bar">
        <a href="/" class="brand" aria-label="Qash, beranda"><img src={logotypeOrange.src} width={logotypeOrange.width} height={logotypeOrange.height} alt="" /></a>

        <nav class="links" aria-label="Utama">
          <div class="has-menu">
            <button type="button" aria-expanded="false" aria-controls="mega-fitur">Fitur <span class="chev" set:html={chevron} /></button>
            <div class="mega" id="mega-fitur">
              <FeatureMenu />
              <div class="mega-foot">
                <span>Semua modul ada di setiap akun. Anda memilih yang aktif per outlet.</span>
                <a href="/harga" class="text-link arrow">Lihat harganya</a>
              </div>
            </div>
          </div>
          <a href="/jenis-usaha">Jenis usaha</a>
          <a href="/harga">Harga</a>
          <a href="/#faq">FAQ</a>
        </nav>

        <div class="actions">
          <!-- <a href={appUrl} class="signin">Masuk</a> -->
          <a href={waUrl} class="btn btn-primary btn-sm"><span class="btn-icon" set:html={icons.whatsapp} />Jadwalkan demo</a>
        </div>

        <div class="menu">
          <button type="button" class="burger" aria-expanded="false" aria-controls="drawer" aria-label="Buka menu"><span></span><span></span><span></span></button>
          <div class="drawer" id="drawer">
            <div class="drawer-bar">
              <button type="button" class="close" data-close aria-label="Tutup menu" set:html={cross} />
              <a href="/" aria-label="Qash, beranda"><img src={logotypeOrange.src} width={logotypeOrange.width} height={logotypeOrange.height} alt="" /></a>
            </div>
            <div class="panels">
              <nav class="panel main" aria-label="Menu">
                <span class="menu-label">Menu utama</span>
                <button type="button" data-go="fitur">Fitur <span class="go" set:html={chevron} /></button>
                <a href="/jenis-usaha">Jenis usaha</a>
                <a href="/harga">Harga</a>
                <a href="/#faq">FAQ</a>
                <a href={appUrl}>Masuk</a>
              </nav>
              <nav class="panel sub" data-panel="fitur" aria-label="Fitur">
                <button type="button" class="menu-label back" data-back><span class="go" set:html={chevron} />Fitur</button>
                <FeatureMenu />
              </nav>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container foot">
        <div class="foot-brand">
          <img src={logotypeOrange.src} width={logotypeOrange.width} height={logotypeOrange.height} alt="Qash" loading="lazy" />
          <p>Sistem operasional F&amp;B lengkap untuk kedai, kafe, dan restoran di Indonesia. Gratis untuk pemilik usaha, Rp1.000 per transaksi.</p>
          <a href={waSalesUrl} class="btn btn-ghost-light btn-sm"><span class="btn-icon" set:html={icons.whatsapp} />{waDisplay}</a>
        </div>
        <nav aria-label="Produk">
          <h4>Produk</h4>
          {suites.map((s) => <a href={`/fitur/${s.slug}`}>{s.name}</a>)}
        </nav>
        <nav aria-label="Jenis usaha">
          <h4>Jenis usaha</h4>
          {businessTypes.map((b) => <a href={`/jenis-usaha#${b.slug}`}>{b.name}</a>)}
        </nav>
        <nav aria-label="Qash">
          <h4>Qash</h4>
          <a href="/harga">Harga</a>
          <a href="/#faq">FAQ</a>
          <a href={appUrl}>Masuk ke Qash</a>
          <a href={waSalesUrl}>WhatsApp</a>
          {/* TODO legal: sambungkan ke /privasi dan /syarat saat dokumennya siap. */}
          <span class="soon">Kebijakan privasi <em>segera</em></span>
          <span class="soon">Syarat layanan <em>segera</em></span>
        </nav>
      </div>
      <div class="container legal">
        {/* TODO legal: nama PT, alamat terdaftar, dan NIB mengisi baris ini. */}
        <p>© {year} Qash</p>
        <p>Bahasa Indonesia &amp; Inggris · Berjalan di browser</p>
      </div>
    </footer>

    <a href={waHref} class="wa-bar"><span class="btn-icon" set:html={icons.whatsapp} />Chat via WhatsApp</a>

    {/* Custom cursor for mouse users (src/scripts/cursor.ts); a manual popover so it sits above the full-screen view. */}
    <div class="cur" popover="manual" aria-hidden="true" transition:persist="cursor"><i class="cur-dot"><b></b></i><i class="cur-ring"><b></b></i></div>

    <script>
      import { initMotion, resetMotion } from '../scripts/motion';
      import '../scripts/zoom';
      import '../scripts/cursor';

      function init() {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Scroll reveal for the page that just loaded.
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.in)');
        if (reduce || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('in');
                  io.unobserve(entry.target);
                }
              }
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
          );
          targets.forEach((el) => io.observe(el));
        }

        // The header persists across page transitions, so bind its handlers once.
        const header = document.querySelector<HTMLElement>('.site-header');
        if (header && !header.dataset.bound) {
          header.dataset.bound = '1';
          const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
          addEventListener('scroll', onScroll, { passive: true });
          onScroll();

          header.querySelectorAll<HTMLElement>('.has-menu').forEach((wrap) => {
            const button = wrap.querySelector('button')!;
            const setOpen = (open: boolean) => {
              wrap.classList.toggle('open', open);
              button.setAttribute('aria-expanded', String(open));
            };
            button.addEventListener('click', () => setOpen(!wrap.classList.contains('open')));
            wrap.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) setOpen(false); });
            document.addEventListener('click', (e) => { if (!wrap.contains(e.target as Node)) setOpen(false); });
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
          });

          // Phone drawer: the burger slides in a full-screen sheet; an item with a sub-menu ([data-go]) slides its
          // panel ([data-panel]) in over the list, the panel's back button slides it out again.
          const menu = header.querySelector<HTMLElement>('.menu');
          if (menu) {
            const burger = menu.querySelector<HTMLButtonElement>('.burger')!;
            const show = (name: string | null) => {
              menu.classList.toggle('deep', name !== null);
              menu.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => p.classList.toggle('on', p.dataset.panel === name));
            };
            const setOpen = (open: boolean) => {
              menu.classList.toggle('open', open);
              burger.setAttribute('aria-expanded', String(open));
              if (!open) show(null);
            };
            burger.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
            menu.addEventListener('click', (e) => {
              const t = e.target as Element;
              const go = t.closest<HTMLElement>('[data-go]');
              if (go) show(go.dataset.go!);
              else if (t.closest('[data-back]')) show(null);
              else if (t.closest('a, [data-close]')) setOpen(false);
            });
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
          }

          // A group's chevron in the Fitur menu unfolds its features; the CSS in FeatureMenu.astro animates it.
          header.addEventListener('click', (e) => {
            const fold = (e.target as Element).closest<HTMLButtonElement>('[data-fold]');
            if (fold) fold.setAttribute('aria-expanded', String(fold.getAttribute('aria-expanded') !== 'true'));
          });
        }

        // Mark the current page in the nav.
        const path = location.pathname.replace(/\/$/, '') || '/';
        document.querySelectorAll<HTMLAnchorElement>('.site-header .links > a, .site-header .menu a').forEach((a) => {
          const href = (a.getAttribute('href') ?? '').replace(/\/$/, '');
          const current = href !== '' && href !== '/' && !href.includes('#') && path.startsWith(href);
          if (current) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });

        // Mobile WhatsApp bar: stays out of the way while a primary button is already on screen.
        const w = window as Window & { __ctaIO?: IntersectionObserver };
        w.__ctaIO?.disconnect();
        if ('IntersectionObserver' in window) {
          const visible = new Set<Element>();
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
            document.body.classList.toggle('cta-visible', visible.size > 0);
          });
          document.querySelectorAll('main .btn-primary').forEach((b) => io.observe(b));
          w.__ctaIO = io;
        }

        // GSAP: headline reveals, the scrubbed flow, printing receipts. If it ever fails, show the headlines anyway.
        initMotion().catch((err) => {
          console.error(err);
          document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => (el.style.visibility = 'visible'));
        });
      }

      document.addEventListener('astro:page-load', init);
      document.addEventListener('astro:before-swap', resetMotion);
      // The router copies <html> attributes from the fetched page, which never has the class the inline head script adds.
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
      // The dev server can finish loading the page before this module has run, so the event above is already gone.
      if (document.readyState === 'complete') init();
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 300ms var(--ease), box-shadow 300ms var(--ease);
  }
  .site-header.scrolled { border-bottom-color: var(--line); box-shadow: 0 12px 32px -24px rgba(13, 25, 72, 0.4); }
  .bar { position: relative; display: flex; align-items: center; gap: 2rem; min-height: 4.75rem; }
  .brand { display: inline-flex; }
  .brand img { display: block; height: 2rem; width: auto; }

  .links { display: flex; align-items: center; gap: clamp(1rem, 2.5vw, 2rem); margin-right: auto; font-family: var(--font-display); font-size: 1rem; font-weight: 600; }
  .links > a, .links button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0;
    border: 0;
    background: none;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .links > a::after, .links button::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease);
  }
  .links > a:hover::after, .links > a[aria-current]::after, .has-menu:hover button::after, .has-menu.open button::after { transform: scaleX(1); }
  .chev { display: inline-flex; width: 0.8rem; height: 0.8rem; transition: transform 250ms var(--ease); }
  .chev :global(svg) { width: 100%; height: 100%; }
  .has-menu:hover .chev, .has-menu.open .chev { transform: rotate(180deg); }

  /* Mega menu: a sheet under the bar, spanning the container. */
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin-top: -1px;
    padding: 1.75rem 2rem 1.4rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 0 0 var(--radius) var(--radius);
    box-shadow: 0 40px 60px -30px rgba(13, 25, 72, 0.4);
    font-family: var(--font-body);
    font-weight: 400;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 250ms var(--ease), transform 250ms var(--ease), visibility 250ms;
  }
  .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -1.25rem; height: 1.25rem; }
  .has-menu:hover .mega, .has-menu.open .mega, .has-menu:focus-within .mega { opacity: 1; visibility: visible; transform: none; }
  .mega { max-height: calc(100vh - 6rem); overflow-y: auto; }
  .mega-foot { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--line); font-size: 0.92rem; color: var(--muted); }

  .actions { display: flex; align-items: center; gap: 1rem; }
  .signin { font-family: var(--font-display); font-weight: 600; text-decoration: none; }
  .signin:hover { color: var(--orange-text); }

  /* Phone drawer: a full-screen sheet over the header (its containing block, so it is absolute, not fixed), with a
     stack of panels; the sub-panel slides in from the right over the main list. */
  .menu { display: none; }
  .burger { display: grid; gap: 5px; padding: 0.65rem; border: 0; border-radius: 8px; background: none; cursor: pointer; }
  .burger span { display: block; width: 22px; height: 2px; border-radius: 2px; background: var(--ink); }
  .drawer {
    position: absolute;
    inset: 0 0 auto;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--white);
    visibility: hidden;
    transform: translateX(-100%);
    transition: transform 400ms var(--ease), visibility 400ms;
  }
  .menu.open .drawer { visibility: visible; transform: none; }
  .drawer-bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 4.75rem; padding-inline: 0.5rem; border-bottom: 1px solid var(--line); }
  .drawer-bar img { display: block; height: 2rem; width: auto; }
  .close { display: inline-flex; width: 2.75rem; height: 2.75rem; padding: 0.65rem; border: 0; border-radius: 8px; background: none; color: var(--ink); cursor: pointer; }
  .close :global(svg) { width: 100%; height: 100%; }
  .panels { position: relative; flex: 1; overflow: hidden; }
  .panel {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    display: grid;
    align-content: start;
    padding: 0.75rem 1.25rem 2rem;
    background: var(--white);
    transition: transform 400ms var(--ease), visibility 400ms;
  }
  .panel.sub { transform: translateX(100%); visibility: hidden; }
  .menu.open .panel.sub.on { transform: none; visibility: visible; }
  .menu.deep .panel.main { transform: translateX(-20%); visibility: hidden; }
  .panel.main > a, .panel.main > button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0.25rem;
    border: 0;
    background: none;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .panel.main > a[aria-current] { color: var(--orange-text); }
  .go { display: inline-flex; width: 1rem; height: 1rem; color: var(--muted); transform: rotate(-90deg); }
  .go :global(svg) { width: 100%; height: 100%; }
  .menu-label { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.75rem; padding: 0.75rem 0.25rem 0.9rem; border: 0; border-bottom: 1px solid var(--line); background: none; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .back { cursor: pointer; }
  .back .go { transform: rotate(90deg); color: var(--ink); }

  @media (max-width: 1080px) {
    .links, .signin { display: none; }
    .actions { margin-left: auto; }
    .bar { position: static; }
    .menu { display: block; }
    :global(html:has(.site-header .menu.open)) { overflow: hidden; }
  }
  @media (max-width: 480px) {
    .actions .btn { display: none; }
  }

  /* Sticky WhatsApp button for phones; hidden while a primary button is on screen (body.cta-visible). */
  .wa-bar { display: none; }
  @media (max-width: 700px) {
    .wa-bar {
      position: fixed;
      left: 50%;
      bottom: calc(1rem + env(safe-area-inset-bottom));
      z-index: 25;
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.95rem 1.5rem;
      border-radius: 999px;
      background: var(--orange);
      color: var(--ink);
      font-family: var(--font-display);
      font-weight: 600;
      white-space: nowrap;
      text-decoration: none;
      transform: translateX(-50%);
      transition: transform 350ms var(--ease), opacity 350ms var(--ease);
    }
    :global(body.cta-visible) .wa-bar { transform: translate(-50%, 160%); opacity: 0; }
    .site-footer { padding-bottom: 6rem; }
  }

  .site-footer { padding-block: 3.5rem 2rem; background: var(--navy-deep); color: rgba(255, 255, 255, 0.78); font-size: 0.95rem; }
  .foot { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2.5rem 3rem; }
  .foot-brand img { height: 1.6rem; width: auto; }
  .foot-brand p { margin: 1rem 0 1.25rem; max-width: 32ch; }
  .foot h4 { margin-bottom: 0.9rem; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--orange); }
  .foot nav { display: grid; align-content: start; gap: 0.45rem; }
  .foot nav a { color: var(--white); text-decoration: none; }
  .foot nav a:hover { color: var(--orange); }
  .soon { color: rgba(255, 255, 255, 0.5); }
  .soon em { margin-left: 0.4rem; padding: 0.05rem 0.45rem; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 999px; font-size: 0.72rem; font-style: normal; letter-spacing: 0.06em; text-transform: uppercase; }
  .legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 2rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 0.85rem; color: rgba(255, 255, 255, 0.55); }
  @media (max-width: 900px) { .foot { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .foot { grid-template-columns: 1fr; } }
</style>
